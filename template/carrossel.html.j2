{#-
  Carrossel "o que saiu no grupo" — 1 capa + 1 slide por produto + 1 CTA.
  Canvas de cada slide: 1080x1440 (3:4).
  Todas as variáveis chegam prontas do scripts/carrossel.py: preços já formatados,
  gancho já calculado e coordenadas já em px. O template não faz conta nenhuma.
-#}
{%- macro posicao(e) -%}
  top:{{ e.y }}px;{% if e.alinhar == 'direita' %}right:{{ 1080 - e.x }}px;align-items:flex-end;{% else %}left:{{ e.x }}px;align-items:flex-start;{% endif %}
{%- endmacro -%}
{%- macro seta(s) -%}
  {% if s %}<img class="seta" src="{{ s.url }}" alt="" style="top:{{ s.y }}px;left:{{ s.x }}px;width:{{ s.largura }}px;transform:rotate({{ s.rot }}deg)">{% endif %}
{%- endmacro -%}
<!doctype html>
<html lang="pt-BR">
<head>
<meta charset="utf-8">
<title>{{ titulo }}</title>
<style>
@font-face{font-family:'Mao';font-style:normal;font-weight:400;src:url("{{ assets }}/fontes/shadows-into-light-two-latin-ext.woff2") format('woff2');unicode-range:U+0100-02BA,U+02BD-02C5,U+02C7-02CC,U+02CE-02D7,U+02DD-02FF,U+0304,U+0308,U+0329,U+1D00-1DBF,U+1E00-1E9F,U+1EF2-1EFF,U+2020,U+20A0-20AB,U+20AD-20C0,U+2113,U+2C60-2C7F,U+A720-A7FF}
@font-face{font-family:'Mao';font-style:normal;font-weight:400;src:url("{{ assets }}/fontes/shadows-into-light-two-latin.woff2") format('woff2');unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
:root{--laranja:#ff7a1a;--risco:#ff4a3d;--cinza:#bdbdbd;--fundo:#121212;--branco:#fff}
*{margin:0;padding:0;box-sizing:border-box}
body{background:#0d0d0d}
section{position:relative;width:1080px;height:1440px;overflow:hidden;font-family:'Mao',cursive;color:var(--branco)}
.foto{background:#111 url("{{ foto }}") center/cover no-repeat}
.sombra{text-shadow:0 2px 12px rgba(0,0,0,.7)}
.bloco{position:absolute;display:flex;flex-direction:column}
.seta{position:absolute;filter:drop-shadow(0 2px 6px rgba(0,0,0,.5))}
.riscado{position:relative}
.riscado::after{content:"";position:absolute;left:-6px;right:-8px;top:54%;height:5px;border-radius:4px;background:var(--risco);transform:rotate(-7deg)}
.riscado.grande::after{left:-10px;right:-14px;height:9px;border-radius:6px}
.laranja{color:var(--laranja)}
</style>
</head>
<body>

{# ---------- 1. CAPA ---------- #}
<section class="foto" data-slide="capa">
  <div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,0,0,.55) 0%,rgba(0,0,0,0) 14%),radial-gradient(ellipse 520px 300px at 220px 330px,rgba(0,0,0,.45),rgba(0,0,0,0)),linear-gradient(0deg,rgba(0,0,0,.5) 0%,rgba(0,0,0,0) 22%)"></div>

  <div class="bloco sombra" data-check="gancho" style="top:{{ gancho.y }}px;left:{{ gancho.x }}px;right:60px">
    <span style="font-size:60px;line-height:1.05">{{ gancho.linha1 }}</span>
    <span class="laranja" style="font-size:60px;line-height:1.05">{{ gancho.linha2 }}</span>
  </div>

  {% for p in produtos %}
  <div class="bloco sombra" data-check="etiqueta-{{ p.id }}" style="{{ posicao(p.capa.etiqueta) }}">
    <span style="font-size:28px;line-height:1">{{ p.nome }}</span>
    <span class="laranja" style="font-size:86px;line-height:1.1">{{ p.preco_cheio }}</span>
  </div>
  {{ seta(p.capa.seta) }}
  {% endfor %}

  <div class="sombra" data-check="desliza" style="position:absolute;bottom:40px;right:44px;display:flex;align-items:center;gap:16px">
    <span style="font-size:52px;line-height:1">{{ texto.desliza }}</span>
    <img src="{{ assets }}/setas/assinatura.png" alt="" style="width:150px">
  </div>
</section>

{# ---------- 2. UM SLIDE POR PRODUTO ---------- #}
{% for p in produtos %}
<section style="background:var(--fundo)" data-slide="produto-{{ p.id }}">
  <div style="position:absolute;top:0;left:0;right:0;height:640px;background:url('{{ foto }}') no-repeat;background-size:{{ p.recorte.w }}px auto;background-position:{{ p.recorte.x }}px {{ p.recorte.y }}px"></div>
  <div style="position:absolute;top:470px;left:0;right:0;height:170px;background:linear-gradient(0deg,var(--fundo),rgba(18,18,18,0))"></div>

  <div class="bloco" data-check="texto-{{ p.id }}" style="top:640px;left:56px;width:500px">
    <span style="font-size:48px;line-height:1">{{ p.nome }}</span>
    <span style="font-size:32px;line-height:1;margin-top:40px;color:var(--cinza)">{{ texto.rotulo_cheio }}</span>
    <div class="riscado grande" style="align-self:flex-start">
      <span style="font-size:92px;line-height:1.35;color:var(--cinza)">{{ p.preco_cheio }}</span>
    </div>
    <span class="laranja" style="font-size:48px;line-height:1;margin-top:56px">{{ texto.saiu_por }}</span>
    <span class="laranja" style="font-size:132px;line-height:1.05;margin-top:12px">{{ p.preco_grupo }}</span>
  </div>
  <img src="{{ assets }}/setas/deslize.png" alt="" style="position:absolute;top:1230px;left:380px;width:220px;transform:rotate(6deg)">

  <div data-check="print-{{ p.id }}" style="position:absolute;top:560px;left:600px;width:424px;padding:12px;background:#fff;border-radius:10px;box-shadow:0 18px 50px rgba(0,0,0,.55);transform:rotate(2.5deg)">
    <img src="{{ p.print }}" alt="Print da oferta no grupo" style="display:block;width:100%;height:auto;border-radius:6px">
  </div>
</section>
{% endfor %}

{# ---------- 3. CTA ---------- #}
<section class="foto" data-slide="cta">
  <div style="position:absolute;inset:0;background:radial-gradient(ellipse 520px 300px at 220px 330px,rgba(0,0,0,.45),rgba(0,0,0,0)),linear-gradient(0deg,rgba(0,0,0,.85) 0%,rgba(0,0,0,.55) 22%,rgba(0,0,0,0) 40%)"></div>

  {% for p in produtos %}
  <div class="bloco sombra" data-check="final-{{ p.id }}" style="{{ posicao(p.final.etiqueta) }}">
    <span style="font-size:28px;line-height:1">{{ p.nome }}</span>
    <div class="riscado" style="margin-top:8px">
      <span style="font-size:44px;line-height:1.3;opacity:.85">{{ p.preco_cheio }}</span>
    </div>
    <span class="laranja" style="font-size:86px;line-height:1.1">{{ p.preco_grupo }}</span>
  </div>
  {{ seta(p.final.seta) }}
  {% endfor %}

  <div class="bloco sombra" data-check="cta" style="left:60px;right:60px;bottom:70px">
    <span class="laranja" style="font-size:68px;line-height:1.05">{{ texto.cta_1 }}</span>
    <span style="font-size:38px;line-height:1.1">{{ texto.cta_2 }}</span>
  </div>
</section>

</body>
</html>
